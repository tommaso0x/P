# EditorConfig — https://editorconfig.org
# Convenzioni di formattazione condivise per tutti gli editor.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Python (tools/)
[*.py]
indent_style = space
indent_size = 4

# Sorgenti PowerLanguage (testo semplice)
[*.pl]
indent_style = space
indent_size = 4

# Sorgenti PowerLanguage.NET (C#)
[*.cs]
indent_style = space
indent_size = 4

# Markdown, YAML, JSON
[*.{md,yml,yaml,json}]
indent_style = space
indent_size = 2

# In Markdown due spazi finali sono un'interruzione di riga voluta
[*.md]
trim_trailing_whitespace = false
